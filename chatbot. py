def chatbot():
    print("Welcome to AI Chatbot")

    while True:
        user = input("You: ").lower()

        if user == "hello":
            print("Bot: Hi Supriya!")
        elif user == "how are you":
            print("Bot: I am fine.")
        elif user == "bye":
            print("Bot: Goodbye!")
            break
        else:
            print("Bot: I don't understand.")

chatbot()
